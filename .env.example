# Copia este archivo como .env y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# Cadena de conexión a Postgres (proyecto Neon). Usar la conexión "pooled".
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Secreto usado por Auth.js v5 para firmar la sesión JWT.
# Generar uno nuevo con: npx auth secret
AUTH_SECRET=""
